<resources>
    <!-- Android 12+: brand mark on the night background (the system splash API) -->
    <style name="Theme.OnRoad.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.OnRoad</item>
    </style>
</resources>
