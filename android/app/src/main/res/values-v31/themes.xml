<resources>
    <!-- Android 12+: brand mark on the night background (the system splash API) -->
    <style name="Theme.OnRoad.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/night</item>
        <item name="postSplashScreenTheme">@style/Theme.OnRoad</item>
    </style>
</resources>
